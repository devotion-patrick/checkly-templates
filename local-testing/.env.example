# Copy this file to local-testing/.env and fill in your Checkly creds.
# `local-testing/.env` is gitignored. `npm run try:*` (anything except
# validate) will auto-load it before invoking the Checkly CLI.
#
# Get an API key:  https://app.checklyhq.com/settings/user/api-keys
# Find account ID: https://app.checklyhq.com/settings/account/general

CHECKLY_API_KEY=cu_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CHECKLY_ACCOUNT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
