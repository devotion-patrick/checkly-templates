              },
              "kind": {
                "const": "xpath-spa"
              },
              "waitUntil": {
                "enum": [
                  "load",
                  "domcontentloaded",
                  "networkidle"
                ],
                "default": "domcontentloaded",
                "description": "Playwright `page.goto` waitUntil. Default `domcontentloaded`."
              },
              "expect": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "selector"
                  ],
                  "properties": {
                    "selector": {
                      "type": "string",
                      "minLength": 1
                    },
                    "equals": {
                      "type": "string"
                    },
