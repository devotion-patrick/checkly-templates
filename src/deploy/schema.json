                  "EVERY_5M",
                  "EVERY_10M",
                  "EVERY_15M",
                  "EVERY_30M",
                  "EVERY_1H",
                  "EVERY_6H",
                  "EVERY_12H",
                  "EVERY_24H"
                ],
                "description": "Override the project default frequency."
              },
              "locations": {
