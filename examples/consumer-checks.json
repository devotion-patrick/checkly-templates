{
  "$schema": "../src/deploy/schema.json",
  "project": {
    "logicalId": "acme-corporate-checks",
    "name": "Acme - Corporate Website",
    "codename": "acme",
    "tagPrefix": "acme",
    "tags": ["managed-by:checkly-templates"],
    "defaults": {
      "frequency": "EVERY_15M",
      "locations": ["eu-central-1", "ap-southeast-2"]
    }
  },
  "checks": [
    {
      "kind": "uptime-ssl",
      "logicalId": "acme-home-prod-uptime",
      "env": "PROD",
      "url": "https://www.acme.com",
      "sslCertificateExpiryThresholdDays": 30,
      "monitor": true,
      "smoke": false
    },
    {
      "kind": "redirect",
      "logicalId": "acme-apex-redirect-prod",
      "env": "PROD",
      "url": "http://acme.com",
      "expectedStatus": 301,
      "expectedLocation": "https://www.acme.com/",
      "smoke": true,
      "monitor": false
    },
    {
      "kind": "dotnet-health",
      "logicalId": "acme-api-prod-health",
      "env": "PROD",
      "url": "https://api.acme.com/health",
      "expectedComponents": ["sql", "redis"],
      "frequency": "EVERY_5M",
      "smoke": true,
      "monitor": true,
      "headers": [
        { "key": "X-Health-Key", "valueFromEnv": "HEALTH_KEY" }
      ]
    },
    {
      "kind": "xpath",
      "logicalId": "acme-marketing-prod-meta",
      "env": "PROD",
      "url": "https://www.acme.com",
      "expect": {
        "contains": ["<title>Acme - Home</title>"],
        "notContains": ["lorem ipsum"]
      },
      "smoke": true,
      "monitor": false
    },
    {
      "kind": "xpath-spa",
      "logicalId": "acme-app-prod-headline",
      "env": "PROD",
      "url": "https://app.acme.com",
      "waitUntil": "domcontentloaded",
      "expect": [
        { "selector": "h1", "contains": "Welcome" },
        { "selector": ".error-banner", "count": 0 }
      ],
      "smoke": true,
      "monitor": false
    },
    {
      "kind": "gdpr",
      "logicalId": "acme-home-prod-gdpr",
      "env": "PROD",
      "url": "https://www.acme.com",
      "complianceMode": "targeted",
      "preset": "eu-uk-ca",
      "overrides": {
        "trackingDomains": { "add": ["custom-tracker.example.com"] }
      },
      "frequency": "EVERY_24H",
      "locations": ["eu-central-1"],
      "smoke": true,
      "monitor": true
    },
    {
      "kind": "launch-readiness",
      "logicalId": "acme-home-launch-ready",
      "env": "PROD",
      "url": "https://www.acme.com",
      "checks": {
        "placeholderText": true,
        "favicon": true,
        "canonical": { "expectedUrl": "https://www.acme.com/" },
        "h1": true,
        "headingOrder": true,
        "imgAlt": true,
        "metaTitle": { "minLength": 30, "maxLength": 65 },
        "metaDescription": { "minLength": 70, "maxLength": 160 },
        "ogTags": ["og:title", "og:description", "og:image", "og:url"],
        "robotsTxt": true,
        "sitemap": { "spotCheckUrls": 3 },
        "securityHeaders": [
          "X-Content-Type-Options",
          "X-Frame-Options",
          "Strict-Transport-Security",
          "Referrer-Policy"
        ],
        "notFoundPage": true,
        "expectedScripts": ["googletagmanager.com/gtm.js"],
        "recaptchaOnForms": true,
        "trailingSlashRedirect": "drop"
      },
      "smoke": true,
      "monitor": false
    }
  ]
}
